# CLAW PROMPTOPS - Environment Configuration
# Copy this file to .env and adjust as necessary.

# Application & Logging
APP_NAME="CLAW PromptOps"
LOG_LEVEL=INFO

# API Server
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./claw_promptops.db

# Model Execution Defaults
DEFAULT_MODEL=mock-deterministic
MODEL_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_REPAIR_ATTEMPTS=2
CACHE_ENABLED=true

# Provider Settings
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
